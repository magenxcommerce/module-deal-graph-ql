<!--
    Merges the deal presentation fields into the native Catalog Price Rule form
    (Marketing → Catalog Price Rule). The form is a UI component
    (Magento_CatalogRule catalog_rule_form), so fields are added declaratively
    here — NOT via a legacy Data\Form plugin. The columns live on the catalogrule
    table (see etc/db_schema.xml); they prefill from the rule's DataProvider on
    edit and persist via the Rule::loadPost plugin on save.
-->
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <fieldset name="rule_information">
        <field name="magenx_deal_label" formElement="input" sortOrder="100">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Deal Badge Label</label>
                <notice translate="true">Turns this Catalog Price Rule into a storefront deal, e.g. "DEAL" or "SALE". This is the default/fallback label (shown when a store view has no override below). Leave empty for an ordinary price rule (no deal badge).</notice>
                <dataScope>magenx_deal_label</dataScope>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">false</rule>
                </validation>
            </settings>
        </field>
        <dynamicRows name="magenx_deal_label_store" sortOrder="105">
            <settings>
                <componentType>dynamicRows</componentType>
                <label translate="true">Per-Store-View Badge Labels</label>
                <notice translate="true">Optional. Override the badge label per store view for language-specific text (e.g. "SALE" for English, "ANGEBOT" for German). Store views without a row fall back to the default label above.</notice>
                <addButtonLabel translate="true">Add Store View Label</addButtonLabel>
                <dndConfig>
                    <param name="enabled" xsi:type="boolean">false</param>
                </dndConfig>
                <dataScope>magenx_deal_label_store</dataScope>
            </settings>
            <!--
                The row template is a <container name="record">, NOT a <record>
                element: ui_configuration.xsd has no <record>, so the whole form
                fails schema validation and the native Catalog Price Rule form
                stops rendering. isTemplate / is_collection have no <settings>
                equivalents either - they are config items, exactly as every
                core dynamicRows declares them.
            -->
            <container name="record" component="Magento_Ui/js/dynamic-rows/record">
                <argument name="data" xsi:type="array">
                    <item name="config" xsi:type="array">
                        <item name="isTemplate" xsi:type="boolean">true</item>
                        <item name="is_collection" xsi:type="boolean">true</item>
                        <item name="componentType" xsi:type="string">container</item>
                    </item>
                </argument>
                <field name="store_id" formElement="select" sortOrder="10">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Store View</label>
                        <dataScope>store_id</dataScope>
                        <validation>
                            <rule name="required-entry" xsi:type="boolean">true</rule>
                        </validation>
                    </settings>
                    <formElements>
                        <select>
                            <settings>
                                <options class="Magenx\DealGraphQl\Model\Config\Source\StoreView"/>
                            </settings>
                        </select>
                    </formElements>
                </field>
                <field name="label" formElement="input" sortOrder="20">
                    <settings>
                        <dataType>text</dataType>
                        <label translate="true">Badge Label</label>
                        <dataScope>label</dataScope>
                    </settings>
                </field>
                <actionDelete template="Magento_Backend/dynamic-rows/cells/action-delete" sortOrder="30">
                    <settings>
                        <componentType>actionDelete</componentType>
                        <dataType>text</dataType>
                        <label translate="true">Actions</label>
                    </settings>
                </actionDelete>
            </container>
        </dynamicRows>
        <field name="magenx_deal_type" formElement="select" sortOrder="110">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Deal Type</label>
                <notice translate="true">Drives the storefront badge style and the /deals page tab.</notice>
                <dataScope>magenx_deal_type</dataScope>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Magenx\DealGraphQl\Model\Config\Source\Type"/>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
</form>
