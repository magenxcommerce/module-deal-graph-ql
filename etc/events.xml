<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Restore the default customer group after the first order is placed, so the
         first-order deal (a group-scoped Catalog Price Rule) stops applying. Fires
         for GraphQL placeOrder as well as Luma. -->
    <event name="sales_model_service_quote_submit_success">
        <observer name="magenx_deal_remove_first_order_group"
                  instance="Magenx\DealGraphQl\Observer\RemoveFirstOrderGroup"/>
    </event>
</config>
